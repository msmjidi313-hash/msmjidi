{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "msmjidi",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9df3645c-dbb5-4beb-9b66-c0fb8ea2fbea","database_name": "msmjidi" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "55b188e42d9c473ba389db932ca562ab" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
